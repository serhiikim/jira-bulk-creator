{
  "name": "jira-bulk-creator",
  "version": "1.0.0",
  "description": "Bulk create Jira tasks from CSV/JSON data",
  "main": "server.js",
  "scripts": {
    "start": "npm run build && node server.js",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "PORT=3001 nodemon server.js",
    "client": "cd client && npm run dev",
    "build": "cd client && npm run build"
  },
  "keywords": [
    "jira",
    "bulk",
    "tasks",
    "api",
    "express"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.6.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "multer": "^2.0.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "concurrently": "^9.2.0",
    "nodemon": "^3.0.1"
  },
  "engines": {
    "node": ">=14.0.0"
  }
}
